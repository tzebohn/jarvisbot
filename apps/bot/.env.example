DISCORD_TOKEN=
# Only needed for the one-time remove-legacy-commands script, not normal startup.
DISCORD_CLIENT_ID=
# Optional guild scope for legacy cleanup; repeat for each previously registered guild.
DISCORD_GUILD_ID=
YOUTUBE_API_KEY=
# Optional path to the yt-dlp executable; defaults to yt-dlp on PATH.
YT_DLP_PATH=
# Optional lifecycle logs (process exits, audio/voice state changes). Errors always log.
MUSIC_DEBUG=0
# Phase V1: speaker IDs and received packet/PCM-byte counts, never raw audio.
VOICE_RECEIVE_DEBUG=0
# WebRTC VAD aggressiveness: 0 (permissive) to 3 (restrictive); default 2.
VOICE_VAD_MODE=2
# Phase V3: local Jarvis keyword spotting. First run pnpm --filter bot setup:wake.
VOICE_WAKE_ENABLED=1
# Gate/inference/results (including pronunciationId)/cooldown/state logs, no full transcripts or recordings.
VOICE_WAKE_DEBUG=0
# Optional override; defaults to apps/bot/models/wake relative to the app module.
VOICE_WAKE_MODEL_DIR=
# Higher threshold is stricter; higher score boosts the phrase. These are not detection confidence scores.
# Two U.S. English paths (canonical + unstressed ih) live in src/voice/wake/wakeModel.ts.
# Regenerate existing installs with setup:wake --keywords-only. Compare tuning with diagnose:voice.
VOICE_WAKE_THRESHOLD=0.25
VOICE_WAKE_SCORE=1.5
# Phase V4: session ownership, state changes, capture statistics, and completion reasons (no audio).
VOICE_SESSION_DEBUG=0
# Delayed wake cue, using assets/voice/wake-acknowledgement.wav. Must be >300 and <1500 ms.
# Capture starts immediately; command speech suppresses/cancels the cue.
VOICE_WAKE_ACK_DELAY_MS=700
# Phase V5: activated clips only. auto = Groq first, local fallback; local = offline; off = capture only.
GROQ_API_KEY=
VOICE_STT_MODE=auto
# Logs provider/status/timing only. !commandtest explicitly displays transcript text.
VOICE_STT_DEBUG=0
# en by default; auto enables language detection (use a multilingual local model).
VOICE_STT_LANGUAGE=en
# Optional Python executable path, no arguments. Defaults to .venv-stt's Python if present, then Python on PATH.
VOICE_STT_PYTHON=
# Run pnpm --filter bot setup:stt once before using local fallback. Runtime never downloads models.
VOICE_STT_LOCAL_MODEL=small.en
VOICE_STT_DEVICE=cpu
VOICE_STT_COMPUTE_TYPE=int8
VOICE_STT_THREADS=2
# Optional; defaults to apps/bot/models/stt. Keep this directory with the deployment.
VOICE_STT_CACHE_DIR=
# Phase V6: exact local rules first; uncertain text uses the same GROQ_API_KEY.
# hybrid (default) or local. Use local here AND VOICE_STT_MODE=local for fully offline voice.
VOICE_COMMAND_MODE=hybrid
# Groq free-plan model supporting strict JSON schema; overrides must support that API and low reasoning effort.
VOICE_COMMAND_MODEL=openai/gpt-oss-20b
# Type/source/reason/timing only; !commandtest explicitly displays the parsed query.
VOICE_COMMAND_DEBUG=0
